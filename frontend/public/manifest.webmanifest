{
  "name": "Cashbook PRO - Shop Ledger",
  "short_name": "Cashbook PRO",
  "description": "Professional Shop Ledger, Daily Closing & Cash Management App",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#0f172a",
  "theme_color": "#2563eb",
  "categories": ["business", "finance", "productivity"],
  "icons": [
    {
      "src": "/icons/icon-192.svg",
      "sizes": "192x192",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.svg",
      "sizes": "512x512",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.svg",
      "sizes": "512x512",
      "type": "image/svg+xml",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Day Book",
      "short_name": "Day Book",
      "description": "Open Daily Counter Sales Book",
      "url": "/daybook",
      "icons": [{ "src": "/icons/icon-192.svg", "sizes": "192x192" }]
    },
    {
      "name": "Daily Closing",
      "short_name": "Day Close",
      "description": "Open Day Closing & Reconciliation",
      "url": "/daily-closing",
      "icons": [{ "src": "/icons/icon-192.svg", "sizes": "192x192" }]
    },
    {
      "name": "Customers",
      "short_name": "Customers",
      "description": "Open Customer Credit & Khata Book",
      "url": "/credits",
      "icons": [{ "src": "/icons/icon-192.svg", "sizes": "192x192" }]
    }
  ]
}
